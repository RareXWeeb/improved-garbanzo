{
  "manifest_version": 3,
  "name": "SceneForge PromptPad",
  "version": "1.0.0",
  "description": "A lightweight, persistent notepad for saving and instantly copying reusable text and AI prompts.",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "clipboardRead"
  ],
  "action": {
    "default_title": "SceneForge PromptPad"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
